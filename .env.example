# Use 127.0.0.1 for local npm development. Compose sets DB_HOST=db inside containers.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=ecommerce_db
MYSQL_ROOT_PASSWORD=root_password
JWT_SECRET=local-only-change-this-secret
FRONTEND_PORT=80
AUTH_PORT=4001
CATALOG_PORT=4002
ORDER_PORT=4003
COMPOSE_PROJECT_NAME=ecomapp-for-system-architecture-main
IMAGE_NAMESPACE=ecomapp
IMAGE_TAG=local
